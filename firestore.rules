rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isPrimaryAdmin() {
      return signedIn() && request.auth.token.email == "dd7085646@gmail.com";
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId;
      allow update, delete: if signedIn() && (request.auth.uid == userId || isPrimaryAdmin());

      match /personalEvents/{eventId} {
        allow read, delete: if signedIn() && (request.auth.uid == userId || isPrimaryAdmin());
        allow create, update: if signedIn() &&
          request.auth.uid == userId &&
          request.resource.data.userId == userId;
      }
    }

    match /deletedUsers/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isPrimaryAdmin());
      allow create, update, delete: if isPrimaryAdmin();
    }

    match /news/{newsId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn();
      allow delete: if signedIn() && (isPrimaryAdmin() || resource.data.authorId == request.auth.uid);

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if signedIn() && (isPrimaryAdmin() || resource.data.userId == request.auth.uid);
      }
    }

    match /notifications/{notificationId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn();
      allow delete: if isPrimaryAdmin();
    }

    match /fcmTokens/{tokenId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if signedIn() && (isPrimaryAdmin() || resource.data.userId == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
